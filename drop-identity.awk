#!/usr/bin/awk -f
# drop-identity.awk — удаляет из файла переводов пары "одинаковая строка -> та же строка"
# вместе со следующей за ними пустой строкой.
#
# Использование:
#   awk -f drop-identity.awk translations.txt
#   awk -f drop-identity.awk -v squeeze=1 translations.txt   # схлопнуть лишние пустые строки
#
# Формат: русская строка, английская строка, пустая строка между парами.

BEGIN {
    # squeeze=1 — схлопывать подряд идущие пустые строки в одну.
    # squeeze=0 (по умолчанию) — оставлять пустые строки как есть,
    #                            кроме тех, что шли сразу за удалённой парой.
    if (squeeze == "") squeeze = 0

    state = 0          # 0 — ждём русскую строку, 1 — ждём английскую
    rus = ""
    removed = 0
    prev_blank = 0     # 1, если предыдущая выведенная строка была пустой
}

{
    line = $0

    if (state == 0) {
        # Пустая строка между парами — сохраняем как есть
        # (но при squeeze=1 не даём плодить подряд идущие).
        if (line == "") {
            if (squeeze) {
                if (!prev_blank) { print ""; prev_blank = 1 }
            } else {
                print ""
            }
            next
        }
        rus = line
        state = 1
        next
    }

    # state == 1: получили английскую строку
    if (line == rus) {
        # Идентичная пара — удаляем.
        # Пустая строка, которая шла бы после неё (разделитель),
        # будет обработана следующим входом: она либо склеится с уже
        # выведенной пустой, либо будет отброшена при squeeze.
        removed++
        state = 0
        rus = ""
        # Маркер: следующую пустую строку (разделитель удалённой пары)
        # пропускаем, чтобы не осталось "висячей" пустой строки.
        skip_blank = 1
        next
    }

    # Обычная пара — выводим.
    print rus
    print line
    prev_blank = 0
    state = 0
    rus = ""
}

# Хвост: если файл кончился на "русской" строке без пары — это ошибка формата,
# но чтобы не терять данные, выводим её.
END {
    if (state == 1) print rus
    if (removed > 0) printerr("Removed " removed " identity pair(s).")
}